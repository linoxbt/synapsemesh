// Disabled route source: kept out of TanStack file routing by the .disabled suffix.
import { createFileRoute, Link } from "@tanstack/react-router";
import { useState } from "react";
import type { ReactNode } from "react";
import { useQueryClient } from "@tanstack/react-query";
import { useReadContract, useWriteContract } from "wagmi";
import { formatEther, keccak256, parseEther, toHex } from "viem";
import { SiteHeader } from "@/components/SiteHeader";
import { SiteFooter } from "@/components/SiteFooter";
import { TxStatusPanel } from "@/components/TxStatusPanel";
import { CONTRACT_ADDRESSES } from "@/lib/contracts";
import {
  EVOLUTION_CLOCK_ABI,
  FITNESS_ORACLE_ABI,
  GEN_OPS_ABI,
  GENOME_DAO_ABI,
  GENOME_MARKET_ABI,
  INFERENCE_POOL_ABI,
  MODEL_GENOME_ABI,
  useGenomeMarketActivity,
  useLiveGenomeProposals,
  useLiveGenomes,
} from "@/lib/onchain";
import { useTxLifecycle } from "@/lib/tx";
import { useWallet } from "@/lib/wallet";

export const Route = createFileRoute("/evolution")({
  component: EvolutionPage,
});

const SPECIES = ["writing", "code", "reasoning", "creative"] as const;
const PROPOSAL_TYPES = [
  "Mutation rate",
  "Epoch length",
  "Extinction threshold",
  "Deployment threshold",
  "Agent min stake",
] as const;

function bytes32(input: string) {
  return keccak256(toHex(input.trim()));
}

function EvolutionPage() {
  const { address, connect, isCorrectChain, switchToZg } = useWallet();
  const { data: genomes = [], isLoading } = useLiveGenomes();
  const { data: proposals = [] } = useLiveGenomeProposals();
  const { data: marketActivity = [] } = useGenomeMarketActivity();
  const { writeContractAsync } = useWriteContract();
  const queryClient = useQueryClient();
  const tx = useTxLifecycle<string>();

  const [baseModel, setBaseModel] = useState("meta-llama/Llama-3.1-8B");
  const [adapterRoot, setAdapterRoot] = useState("");
  const [species, setSpecies] = useState<(typeof SPECIES)[number]>("reasoning");
  const [genomeId, setGenomeId] = useState("");
  const [parentA, setParentA] = useState("");
  const [parentB, setParentB] = useState("");
  const [alpha, setAlpha] = useState(60);
  const [childRoot, setChildRoot] = useState("");
  const [mutationId, setMutationId] = useState("");
  const [mutationRoot, setMutationRoot] = useState("");
  const [listId, setListId] = useState("");
  const [listPrice, setListPrice] = useState("");
  const [rentalId, setRentalId] = useState("");
  const [rentalPrice, setRentalPrice] = useState("");
  const [rentBlocks, setRentBlocks] = useState("100");
  const [revenueGenomeId, setRevenueGenomeId] = useState("");
  const [revenueAmount, setRevenueAmount] = useState("");
  const [proposalType, setProposalType] = useState(0);
  const [proposalValue, setProposalValue] = useState("");
  const [proposalText, setProposalText] = useState("");

  const { data: mintFee } = useReadContract({
    address: CONTRACT_ADDRESSES.modelGenome,
    abi: MODEL_GENOME_ABI,
    functionName: "mintFee",
    query: { enabled: CONTRACT_ADDRESSES.modelGenome !== "0x" },
  });
  const { data: breedingFee } = useReadContract({
    address: CONTRACT_ADDRESSES.genOps,
    abi: GEN_OPS_ABI,
    functionName: "breedingFee",
    query: { enabled: CONTRACT_ADDRESSES.genOps !== "0x" },
  });
  const { data: generation } = useReadContract({
    address: CONTRACT_ADDRESSES.evolutionClock,
    abi: EVOLUTION_CLOCK_ABI,
    functionName: "currentGeneration",
    query: { enabled: CONTRACT_ADDRESSES.evolutionClock !== "0x" },
  });
  const { data: blocksUntilEpoch } = useReadContract({
    address: CONTRACT_ADDRESSES.evolutionClock,
    abi: EVOLUTION_CLOCK_ABI,
    functionName: "blocksUntilNextEpoch",
    query: { enabled: CONTRACT_ADDRESSES.evolutionClock !== "0x" },
  });

  const deployedCount = genomes.filter((g) => g.status === "DEPLOYED").length;
  const activeCount = genomes.filter((g) => g.status === "ACTIVE").length;
  const revenue = genomes.reduce((sum, g) => sum + Number(g.inferenceRevenue), 0);
  const pendingRewards = genomes.reduce((sum, g) => sum + Number(g.pendingReward), 0);
  const ready = Boolean(address && isCorrectChain);
  const contractReady = (key: keyof typeof CONTRACT_ADDRESSES) => CONTRACT_ADDRESSES[key] !== "0x";
  const missingEvolutionContracts = (
    [
      ["modelGenome", "ModelGenome"],
      ["fitnessOracle", "FitnessOracle"],
      ["genOps", "GenOps"],
      ["evolutionClock", "EvolutionClock"],
      ["inferencePool", "InferencePool"],
      ["genomeMarket", "GenomeMarket"],
      ["genomeDAO", "GenomeDAO"],
    ] as const
  ).filter(([key]) => !contractReady(key));

  async function invalidateEvolution() {
    await Promise.all([
      queryClient.invalidateQueries({ queryKey: ["liveGenomes"] }),
      queryClient.invalidateQueries({ queryKey: ["liveGenomeProposals"] }),
      queryClient.invalidateQueries({ queryKey: ["genomeMarketActivity"] }),
    ]);
  }

  async function runWrite(label: string, fn: () => Promise<`0x${string}`>) {
    if (!ready) return;
    const outcome = await tx.run(async () => {
      const txHash = await fn();
      return { txHash, result: label };
    });
    if (outcome.status === "success") await invalidateEvolution();
  }

  async function mintGenome() {
    await runWrite("Genome minted", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.modelGenome,
        abi: MODEL_GENOME_ABI,
        functionName: "mintSeedGenome",
        args: [
          bytes32(baseModel),
          adapterRoot ? (adapterRoot as `0x${string}`) : bytes32(`${baseModel}:${species}:adapter`),
          bytes32(species),
        ],
        value: (mintFee as bigint | undefined) ?? parseEther("5"),
      }),
    );
  }

  async function requestFitness() {
    if (!genomeId) return;
    await runWrite("Fitness evaluation requested", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.fitnessOracle,
        abi: FITNESS_ORACLE_ABI,
        functionName: "requestEvaluation",
        args: [BigInt(genomeId)],
      }),
    );
  }

  async function crossover() {
    if (!parentA || !parentB) return;
    await runWrite("Crossover submitted", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genOps,
        abi: GEN_OPS_ABI,
        functionName: "crossover",
        args: [
          BigInt(parentA),
          BigInt(parentB),
          childRoot
            ? (childRoot as `0x${string}`)
            : bytes32(`${parentA}:${parentB}:${alpha}:child`),
          bytes32(`${parentA}:${parentB}:lineage:${Date.now()}`),
          BigInt(alpha),
        ],
        value: (breedingFee as bigint | undefined) ?? parseEther("1"),
      }),
    );
  }

  async function mutateGenome() {
    if (!mutationId) return;
    await runWrite("Mutation committed", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genOps,
        abi: GEN_OPS_ABI,
        functionName: "mutate",
        args: [
          BigInt(mutationId),
          mutationRoot ? (mutationRoot as `0x${string}`) : bytes32(`${mutationId}:mutation`),
        ],
      }),
    );
  }

  async function triggerEpoch() {
    await runWrite("Epoch triggered", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.evolutionClock,
        abi: EVOLUTION_CLOCK_ABI,
        functionName: "triggerEpoch",
      }),
    );
  }

  async function listGenome() {
    if (!listId || !listPrice) return;
    await runWrite("Genome listed", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeMarket,
        abi: GENOME_MARKET_ABI,
        functionName: "list",
        args: [BigInt(listId), parseEther(listPrice)],
      }),
    );
  }

  async function setGenomeRentalPrice() {
    if (!rentalId || !rentalPrice) return;
    await runWrite("Rental price set", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeMarket,
        abi: GENOME_MARKET_ABI,
        functionName: "setRentalPrice",
        args: [BigInt(rentalId), parseEther(rentalPrice)],
      }),
    );
  }

  async function rentGenome() {
    if (!rentalId || !rentalPrice || !rentBlocks) return;
    await runWrite("Genome rented", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeMarket,
        abi: GENOME_MARKET_ABI,
        functionName: "rent",
        args: [BigInt(rentalId), BigInt(rentBlocks)],
        value: parseEther(rentalPrice) * BigInt(rentBlocks),
      }),
    );
  }

  async function approveMarket(id: string) {
    await runWrite("Genome approved", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.modelGenome,
        abi: MODEL_GENOME_ABI,
        functionName: "approve",
        args: [CONTRACT_ADDRESSES.genomeMarket, BigInt(id)],
      }),
    );
  }

  async function buyGenome(id: string, price: string) {
    await runWrite("Genome purchased", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeMarket,
        abi: GENOME_MARKET_ABI,
        functionName: "buy",
        args: [BigInt(id)],
        value: parseEther(price),
      }),
    );
  }

  async function addToInferencePool(id: string) {
    await runWrite("Genome added to inference pool", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.inferencePool,
        abi: INFERENCE_POOL_ABI,
        functionName: "addToPool",
        args: [BigInt(id)],
      }),
    );
  }

  async function claimInferenceReward(id: string) {
    await runWrite("Inference reward claimed", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.inferencePool,
        abi: INFERENCE_POOL_ABI,
        functionName: "claimReward",
        args: [BigInt(id)],
      }),
    );
  }

  async function distributeInferenceRevenue() {
    if (!revenueGenomeId || !revenueAmount) return;
    await runWrite("Inference revenue distributed", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.inferencePool,
        abi: INFERENCE_POOL_ABI,
        functionName: "distributeRevenue",
        args: [BigInt(revenueGenomeId)],
        value: parseEther(revenueAmount),
      }),
    );
  }

  async function propose() {
    if (!proposalValue || !proposalText.trim()) return;
    await runWrite("Proposal created", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeDAO,
        abi: GENOME_DAO_ABI,
        functionName: "propose",
        args: [proposalType, BigInt(proposalValue), proposalText.trim()],
      }),
    );
  }

  async function voteProposal(id: string, support: boolean) {
    await runWrite(support ? "Vote cast for" : "Vote cast against", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeDAO,
        abi: GENOME_DAO_ABI,
        functionName: "vote",
        args: [BigInt(id), support],
      }),
    );
  }

  async function executeProposal(id: string) {
    await runWrite("Proposal executed", () =>
      writeContractAsync({
        address: CONTRACT_ADDRESSES.genomeDAO,
        abi: GENOME_DAO_ABI,
        functionName: "execute",
        args: [BigInt(id)],
      }),
    );
  }

  return (
    <div className="min-h-screen flex flex-col">
      <SiteHeader />
      <main className="flex-1">
        <section className="aurora">
          <div className="container-edge pt-20 pb-12">
            <span className="chip">Evolution Lab · 0G Chain</span>
            <h1 className="editorial-h1 text-5xl md:text-7xl mt-6 max-w-4xl">
              Genome NFTs, TEE fitness, market revenue and DAO control.
            </h1>
            <div className="mt-8 flex flex-wrap gap-3">
              {!address ? (
                <button onClick={connect} className="btn-primary">
                  Connect wallet
                </button>
              ) : !isCorrectChain ? (
                <button onClick={switchToZg} className="btn-primary">
                  Switch to 0G
                </button>
              ) : (
                <button
                  onClick={mintGenome}
                  disabled={!contractReady("modelGenome")}
                  className="btn-primary disabled:opacity-40"
                >
                  Mint genome
                </button>
              )}
              <Link to="/docs" className="btn-ghost">
                Contract docs
              </Link>
            </div>
            <TxStatusPanel tx={tx} />
          </div>
        </section>

        <section className="container-edge py-8 grid grid-cols-2 md:grid-cols-5 gap-4">
          <Stat label="Genomes" value={String(genomes.length)} />
          <Stat label="Active" value={String(activeCount)} />
          <Stat label="Deployed" value={String(deployedCount)} />
          <Stat label="Generation" value={generation?.toString() || "0"} />
          <Stat label="Rewards" value={`${pendingRewards.toFixed(3)} OG`} />
        </section>

        {missingEvolutionContracts.length > 0 && (
          <section className="container-edge pb-8">
            <div className="border border-amber-500/30 bg-amber-500/10 rounded-xl px-5 py-4 text-sm text-amber-100">
              Evolution Lab is waiting on configured contract addresses:{" "}
              {missingEvolutionContracts.map(([, label]) => label).join(", ")}.
            </div>
          </section>
        )}

        <section className="container-edge pb-12 grid lg:grid-cols-3 gap-6">
          <div className="lg:col-span-2 card-soft p-6">
            <div className="flex items-center justify-between gap-4 mb-6">
              <h2 className="font-display text-2xl">Genome Registry</h2>
              <button
                onClick={triggerEpoch}
                disabled={
                  !ready || !contractReady("evolutionClock") || Number(blocksUntilEpoch || 0n) > 0
                }
                className="btn-ghost !py-2 !px-4 text-xs disabled:opacity-40"
              >
                Trigger epoch
              </button>
            </div>
            {isLoading ? (
              <p className="text-muted-foreground py-10 text-center">Syncing genomes...</p>
            ) : genomes.length === 0 ? (
              <p className="text-muted-foreground py-10 text-center">
                No genomes indexed from ModelGenome yet.
              </p>
            ) : (
              <div className="grid md:grid-cols-2 gap-4">
                {genomes.map((g) => (
                  <article
                    key={g.id}
                    className="border border-border/70 rounded-xl p-5 bg-background/30"
                  >
                    <div className="flex items-start justify-between gap-4">
                      <div>
                        <p className="font-mono text-xs text-accent">GENOME #{g.id}</p>
                        <h3 className="font-display text-2xl mt-1">{g.speciesLabel}</h3>
                      </div>
                      <span className="chip text-[10px]">{g.status}</span>
                    </div>
                    <dl className="grid grid-cols-3 gap-3 mt-5 text-xs">
                      <Cell label="Fitness" value={`${g.fitnessScore}/100`} />
                      <Cell label="Generation" value={String(g.generation)} />
                      <Cell label="Pending" value={`${Number(g.pendingReward).toFixed(3)} OG`} />
                    </dl>
                    <div className="hairline my-4" />
                    <p className="font-mono text-[10px] text-muted-foreground break-all">
                      adapter {g.adapterStorageRoot}
                    </p>
                    <div className="mt-4 flex flex-wrap gap-2">
                      <button
                        onClick={() => setGenomeId(g.id)}
                        className="btn-ghost !py-1.5 !px-3 text-xs"
                      >
                        Select for fitness
                      </button>
                      <button
                        onClick={() => setListId(g.id)}
                        className="btn-ghost !py-1.5 !px-3 text-xs"
                      >
                        Select market
                      </button>
                      <button
                        onClick={() => {
                          setMutationId(g.id);
                          setMutationRoot(bytes32(`${g.id}:mutation`));
                        }}
                        className="btn-ghost !py-1.5 !px-3 text-xs"
                      >
                        Select mutation
                      </button>
                      <button
                        onClick={() => approveMarket(g.id)}
                        disabled={!ready || CONTRACT_ADDRESSES.genomeMarket === "0x"}
                        className="btn-ghost !py-1.5 !px-3 text-xs disabled:opacity-40"
                      >
                        Approve market
                      </button>
                      {g.status === "DEPLOYED" && !g.inPool && (
                        <button
                          onClick={() => addToInferencePool(g.id)}
                          disabled={!ready || CONTRACT_ADDRESSES.inferencePool === "0x"}
                          className="btn-ghost !py-1.5 !px-3 text-xs disabled:opacity-40"
                        >
                          Add to pool
                        </button>
                      )}
                      {Number(g.pendingReward) > 0 && (
                        <button
                          onClick={() => claimInferenceReward(g.id)}
                          disabled={!ready || CONTRACT_ADDRESSES.inferencePool === "0x"}
                          className="btn-ghost !py-1.5 !px-3 text-xs disabled:opacity-40"
                        >
                          Claim rewards
                        </button>
                      )}
                      {g.listed && g.listingPrice && (
                        <button
                          onClick={() => buyGenome(g.id, g.listingPrice || "0")}
                          disabled={!ready || CONTRACT_ADDRESSES.genomeMarket === "0x"}
                          className="btn-ghost !py-1.5 !px-3 text-xs disabled:opacity-40"
                        >
                          Buy
                        </button>
                      )}
                      {g.listed && <span className="chip text-[10px]">{g.listingPrice} OG</span>}
                      {g.rentalPrice && (
                        <span className="chip text-[10px]">rent {g.rentalPrice} OG/block</span>
                      )}
                      {g.inPool && <span className="chip text-[10px]">Inference pool</span>}
                    </div>
                  </article>
                ))}
              </div>
            )}
          </div>

          <aside className="space-y-6">
            <Panel title="Mint Seed Genome">
              <Input label="Base model" value={baseModel} setValue={setBaseModel} />
              <Select
                label="Species"
                value={species}
                setValue={(v) => setSpecies(v as (typeof SPECIES)[number])}
                options={SPECIES}
              />
              <Input
                label="Adapter root"
                value={adapterRoot}
                setValue={setAdapterRoot}
                placeholder="0G Storage root or leave blank"
              />
              <button
                onClick={mintGenome}
                disabled={!ready || !contractReady("modelGenome")}
                className="btn-primary w-full disabled:opacity-40"
              >
                Pay {mintFee ? formatEther(mintFee as bigint) : "5"} OG & mint
              </button>
            </Panel>

            <Panel title="Fitness Oracle">
              <Input label="Genome ID" value={genomeId} setValue={setGenomeId} />
              <button
                onClick={requestFitness}
                disabled={!ready || !genomeId || !contractReady("fitnessOracle")}
                className="btn-primary w-full disabled:opacity-40"
              >
                Request TEE evaluation
              </button>
            </Panel>

            <Panel title="Genetic Operators">
              <div className="grid grid-cols-2 gap-3">
                <Input label="Parent A" value={parentA} setValue={setParentA} />
                <Input label="Parent B" value={parentB} setValue={setParentB} />
              </div>
              <Input label="Child adapter root" value={childRoot} setValue={setChildRoot} />
              <label className="grid gap-2 text-xs uppercase tracking-widest text-muted-foreground">
                Alpha {alpha}%
                <input
                  type="range"
                  min={0}
                  max={100}
                  value={alpha}
                  onChange={(e) => setAlpha(Number(e.target.value))}
                />
              </label>
              <button
                onClick={crossover}
                disabled={!ready || !parentA || !parentB || !contractReady("genOps")}
                className="btn-primary w-full disabled:opacity-40"
              >
                Crossover
              </button>
            </Panel>

            <Panel title="Mutation">
              <Input label="Genome ID" value={mutationId} setValue={setMutationId} />
              <Input label="New adapter root" value={mutationRoot} setValue={setMutationRoot} />
              <button
                onClick={mutateGenome}
                disabled={!ready || !mutationId || !contractReady("genOps")}
                className="btn-primary w-full disabled:opacity-40"
              >
                Commit mutation
              </button>
            </Panel>
          </aside>
        </section>

        <section className="container-edge pb-20 grid lg:grid-cols-3 gap-6">
          <Panel title="Genome Market">
            <Input label="Genome ID" value={listId} setValue={setListId} />
            <Input label="Price (OG)" value={listPrice} setValue={setListPrice} />
            <button
              onClick={listGenome}
              disabled={!ready || !listId || !listPrice || !contractReady("genomeMarket")}
              className="btn-primary w-full disabled:opacity-40"
            >
              List genome
            </button>
            <div className="hairline my-4" />
            <Input label="Rental genome ID" value={rentalId} setValue={setRentalId} />
            <Input label="OG per block" value={rentalPrice} setValue={setRentalPrice} />
            <Input label="Blocks" value={rentBlocks} setValue={setRentBlocks} />
            <div className="grid grid-cols-2 gap-2">
              <button
                onClick={setGenomeRentalPrice}
                disabled={!ready || !rentalId || !rentalPrice || !contractReady("genomeMarket")}
                className="btn-ghost !py-2 !px-3 text-xs disabled:opacity-40"
              >
                Set rent
              </button>
              <button
                onClick={rentGenome}
                disabled={
                  !ready ||
                  !rentalId ||
                  !rentalPrice ||
                  !rentBlocks ||
                  !contractReady("genomeMarket")
                }
                className="btn-ghost !py-2 !px-3 text-xs disabled:opacity-40"
              >
                Rent
              </button>
            </div>
            <div className="hairline my-4" />
            <ul className="space-y-2 text-xs">
              {marketActivity.slice(0, 6).map((m, i) => (
                <li key={`${m.kind}-${m.genomeId}-${i}`} className="flex justify-between gap-3">
                  <span className="text-muted-foreground">
                    {m.kind} #{m.genomeId}
                  </span>
                  <span className="font-mono">{Number(m.amount).toFixed(3)} OG</span>
                </li>
              ))}
            </ul>
          </Panel>

          <Panel title="Inference Revenue">
            <Input label="Genome ID" value={revenueGenomeId} setValue={setRevenueGenomeId} />
            <Input label="Revenue (OG)" value={revenueAmount} setValue={setRevenueAmount} />
            <button
              onClick={distributeInferenceRevenue}
              disabled={
                !ready || !revenueGenomeId || !revenueAmount || !contractReady("inferencePool")
              }
              className="btn-primary w-full disabled:opacity-40"
            >
              Distribute revenue
            </button>
            <p className="text-xs text-muted-foreground">
              Lifetime routed: {revenue.toFixed(3)} OG
            </p>
          </Panel>

          <Panel title="Genome DAO">
            <Select
              label="Proposal type"
              value={String(proposalType)}
              setValue={(v) => setProposalType(Number(v))}
              options={PROPOSAL_TYPES.map((_, i) => String(i))}
              render={(v) => PROPOSAL_TYPES[Number(v)] ?? v}
            />
            <Input label="Value" value={proposalValue} setValue={setProposalValue} />
            <Input label="Description" value={proposalText} setValue={setProposalText} />
            <button
              onClick={propose}
              disabled={!ready || !proposalValue || !proposalText || !contractReady("genomeDAO")}
              className="btn-primary w-full disabled:opacity-40"
            >
              Create proposal
            </button>
          </Panel>

          <div className="card-soft p-6">
            <h2 className="font-display text-xl mb-5">DAO Proposals</h2>
            {proposals.length === 0 ? (
              <p className="text-sm text-muted-foreground">No proposals indexed.</p>
            ) : (
              <ul className="space-y-3">
                {proposals.slice(0, 6).map((p) => (
                  <li key={p.id} className="border border-border/60 rounded-lg p-3">
                    <p className="font-mono text-xs text-accent">Proposal #{p.id}</p>
                    <p className="text-sm mt-1">{p.description}</p>
                    <p className="text-[10px] text-muted-foreground mt-2">
                      for {p.forVotes} · against {p.againstVotes} · ends {p.endBlock}
                    </p>
                    <div className="mt-3 flex flex-wrap gap-2">
                      <button
                        onClick={() => voteProposal(p.id, true)}
                        disabled={!ready || !contractReady("genomeDAO")}
                        className="btn-ghost !py-1 !px-2 text-[10px] disabled:opacity-40"
                      >
                        Vote for
                      </button>
                      <button
                        onClick={() => voteProposal(p.id, false)}
                        disabled={!ready || !contractReady("genomeDAO")}
                        className="btn-ghost !py-1 !px-2 text-[10px] disabled:opacity-40"
                      >
                        Vote against
                      </button>
                      <button
                        onClick={() => executeProposal(p.id)}
                        disabled={!ready || p.executed || !contractReady("genomeDAO")}
                        className="btn-ghost !py-1 !px-2 text-[10px] disabled:opacity-40"
                      >
                        Execute
                      </button>
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      </main>
      <SiteFooter />
    </div>
  );
}

function Stat({ label, value }: { label: string; value: string }) {
  return (
    <div className="card-soft p-5">
      <p className="text-[11px] uppercase tracking-widest text-muted-foreground">{label}</p>
      <p className="font-display text-3xl mt-2">{value}</p>
    </div>
  );
}

function Cell({ label, value }: { label: string; value: string }) {
  return (
    <div>
      <dt className="text-muted-foreground">{label}</dt>
      <dd className="font-mono text-sm mt-1">{value}</dd>
    </div>
  );
}

function Panel({ title, children }: { title: string; children: ReactNode }) {
  return (
    <div className="card-soft p-6 space-y-4">
      <h2 className="font-display text-xl">{title}</h2>
      {children}
    </div>
  );
}

function Input({
  label,
  value,
  setValue,
  placeholder,
}: {
  label: string;
  value: string;
  setValue: (value: string) => void;
  placeholder?: string;
}) {
  return (
    <label className="grid gap-2 text-xs uppercase tracking-widest text-muted-foreground">
      {label}
      <input
        value={value}
        onChange={(e) => setValue(e.target.value)}
        placeholder={placeholder}
        className="bg-secondary/40 border border-border rounded-lg px-3 py-2 text-sm normal-case tracking-normal text-foreground font-mono"
      />
    </label>
  );
}

function Select({
  label,
  value,
  setValue,
  options,
  render,
}: {
  label: string;
  value: string;
  setValue: (value: string) => void;
  options: readonly string[];
  render?: (value: string) => string;
}) {
  return (
    <label className="grid gap-2 text-xs uppercase tracking-widest text-muted-foreground">
      {label}
      <select
        value={value}
        onChange={(e) => setValue(e.target.value)}
        className="bg-secondary/40 border border-border rounded-lg px-3 py-2 text-sm normal-case tracking-normal text-foreground"
      >
        {options.map((o) => (
          <option key={o} value={o}>
            {render ? render(o) : o}
          </option>
        ))}
      </select>
    </label>
  );
}
